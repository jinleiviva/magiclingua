#!/bin/bash
# ============================================================================
# MagicLingua 一键安装（普通用户入口）
#
# 用法：双击运行本文件，或终端执行 ./install.command
#
# 它会自动完成：
#   1. 创建 Python 虚拟环境 + 安装翻译引擎（Apple Silicon 免编译）
#   2. 安装运行依赖
#   3. 下载翻译模型（约 1.1GB，带进度条）
#   4. 注册 launchd 自启 + Chrome 原生宿主
#   5. 打印扩展安装指引
#
# 如需 PDF 翻译（多约 470MB）：先运行本脚本，再执行 ./setup_env.sh --with-pdf
# ============================================================================
cd "$(dirname "$0")"

# 用当前用户可用的 shell 执行安装脚本（双击时 .command 由默认 shell 运行）
if [ -t 0 ]; then
    # 终端里直接跑：实时看到全部输出
    ./setup_env.sh "$@"
else
    # 双击场景：保持窗口不闪退，跑完提示按任意键关闭
    ./setup_env.sh "$@"
    echo ""
    echo "安装完成，按任意键关闭窗口..."
    read -r _
fi
