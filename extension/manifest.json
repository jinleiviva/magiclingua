{
  "manifest_version": 3,
  "name": "MagicLingua",
  "version": "2.0.0",
  "description": "本地 HY-MT 模型：网页整页翻译、YouTube 双语字幕、PDF 保留版面翻译",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:18770/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "injected/yt-player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/UniversalCore.js",
        "adapters/VideoAdapter.js",
        "adapters/TextFeedAdapter.js",
        "site_registry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:18770/*"
      ],
      "js": [
        "core/LocalBridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
